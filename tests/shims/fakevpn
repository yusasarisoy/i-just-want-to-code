#!/usr/bin/env zsh
# Fake VPN client. `up` starts a second mock server on the port in
# $SHIM_STATE/vpn_port (the "VPN-only" host) and returns once it listens.
print -r -- "fakevpn $*" >>$SHIM_STATE/calls.log
pidf=$SHIM_STATE/vpn.pid
case $1 in
  status) [[ -f $pidf ]] && kill -0 $(<$pidf) 2>/dev/null ;;
  up)
    [[ -f $pidf ]] && kill -0 $(<$pidf) 2>/dev/null && exit 0
    python3 ${0:A:h:h}/mock/server.py --port $(<$SHIM_STATE/vpn_port) --log $SHIM_STATE/requests.log >/dev/null 2>$SHIM_STATE/vpn.err &!
    print $! >$pidf
    # Shared macOS runners can take well over 5s to start python; wait up to 60s, stop if it died.
    repeat 600; do
      ${commands[curl]} -s -o /dev/null --max-time 1 http://127.0.0.1:$(<$SHIM_STATE/vpn_port)/ && exit 0
      kill -0 $(<$pidf) 2>/dev/null || { cat $SHIM_STATE/vpn.err >&2; exit 1 }
      sleep 0.1
    done
    exit 1 ;;
  down) [[ -f $pidf ]] && kill $(<$pidf) 2>/dev/null; rm -f $pidf ;;
  never) exit 0 ;;
esac
